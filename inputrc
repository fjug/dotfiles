# ~/.inputrc — readline settings (bash, python REPL, ...), linked by
# link-configs.sh. Bash translation of the Mac's zsh/20-completion.zsh and
# zsh/70-keybindings.zsh plus ~/.dotfiles/.inputrc.

# keep the system defaults (Home/End/PgUp keys, 8-bit input)
$include /etc/inputrc

# --- general (zsh: NO_BEEP) ---
set bell-style none
set enable-bracketed-paste on

# --- completion (zsh: matcher-list case-insensitive, menu select, colours) ---
set completion-ignore-case on
set completion-map-case on
set show-all-if-ambiguous on
set colored-stats on
set colored-completion-prefix on
set mark-symlinked-directories on
set visible-stats on

# --- vi mode (zsh: bindkey -v, KEYTIMEOUT=1) ---
# bashrc does `set -o vi`; this makes every readline program use vi too.
set editing-mode vi
set keyseq-timeout 20

# block cursor in command mode, bar cursor in insert mode (zsh: _set_cursor)
set show-mode-in-prompt on
set vi-ins-mode-string "\1\e[5 q\2"
set vi-cmd-mode-string "\1\e[1 q\2"

# keep the emacs movement keys in insert mode (muscle memory anyway)
set keymap vi-insert
"\C-a": beginning-of-line
"\C-e": end-of-line
"\C-k": kill-line
"\C-u": unix-line-discard
"\C-w": unix-word-rubout
"\C-l": clear-screen
# history search on the arrows, scoped to what is already typed
# (closest readline match for zsh-history-substring-search: a prefix search)
"\e[A": history-search-backward
"\e[B": history-search-forward
"\eOA": history-search-backward
"\eOB": history-search-forward

set keymap vi-command
"k": history-search-backward
"j": history-search-forward
"\C-l": clear-screen

set keymap vi-insert
