#!/bin/bash
# htvpn: connect to the HT VPN with openfortivpn, open the SSO sign-in page in
# the background, and reconnect after drops. macOS only.
#
# Replaces FortiClient for daily use: HT disables FortiClient's "Always Up"
# centrally, while openfortivpn --persistent keeps retrying. Profile values
# come from /Library/Application Support/Fortinet/FortiClient/conf/vpn.plist.
#
# sudo needs admin rights, which HT grants for 30 min through Jamf Self
# Service. `adminme` (next to this script) requests them if needed and waits.

GATEWAY="vpn.fht.org:443"

"$(dirname "$(readlink "$0" || echo "$0")")/adminme" || exit 1

sudo -v || exit 1
sudo openfortivpn "$GATEWAY" --saml-login --persistent=10 2>&1 |
while IFS= read -r line; do
  printf '%s\n' "$line"
  if [[ $line =~ Authenticate\ at\ \'([^\']+)\' ]]; then
    open -g "${BASH_REMATCH[1]}"
    osascript -e 'display notification "Sign in to reconnect" with title "HT VPN"'
  fi
done
