# Template for ~/.ssh/config.
#
# The real config is NOT in this repo on purpose — it contains internal
# hostnames and addresses. Copy this, fill in the blanks, and keep it local:
#
#   cp ~/.dotfiles/ssh/config.example ~/.ssh/config
#   chmod 600 ~/.ssh/config
#
# Keys themselves never belong in a git repo. Move them across from the old
# machine over an encrypted channel and `chmod 600` them.

# --- global defaults ---------------------------------------------------------
Host *
    AddKeysToAgent yes
    # macOS only: remembers passphrases in the login keychain, so nothing
    # needs typing. Harmless to leave in on Linux with IgnoreUnknown.
    IgnoreUnknown UseKeychain
    UseKeychain yes
    ServerAliveInterval 60
    ServerAliveCountMax 3
    HashKnownHosts yes

# --- institute ---------------------------------------------------------------
# `ht` is the key these hosts know. It is also what GitHub authenticates with.
Host HPC
    HostName hpclogin.<your-domain>
    User <username>
    IdentityFile ~/.ssh/ht

Host VDI VDI8
    HostName <internal-ip>
    User <username>
    IdentityFile ~/.ssh/ht

# --- compute -----------------------------------------------------------------
Host denbi
    HostName <ip>
    Port <port>
    User ubuntu
    IdentityFile ~/.ssh/ht
    # Then `ssh denbi` replaces the long command, and for the notebook tunnel:
    LocalForward 8888 localhost:8888

# Cloud GPU boxes come and go; keep the current one here rather than as a
# shell alias, so the key and user live in one place.
# Host gpu
#     HostName <ip>
#     User ubuntu
#     IdentityFile ~/.ssh/ht

# --- devices -----------------------------------------------------------------
Host remarkable
    HostName 10.11.99.1
    User root
    # The tablet regenerates its host key on firmware updates.
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null

# --- git hosting -------------------------------------------------------------
Host github.com
    User git
    IdentityFile ~/.ssh/ht
    # Switch this to ~/.ssh/id_ed25519 once you have generated a modern key and
    # registered its public half at https://github.com/settings/keys
